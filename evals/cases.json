    {
      "id": "message-bound-to-field",
      "reference": "base-common.md",
      "task": "Напиши на BSL серверную проверку заполнения реквизита Контрагент. Если он пуст, покажи пользователю сообщение, привязанное к полю формы, и установи Отказ. Используй штатный API БСП 3.1.11.",
      "should_trigger": true,
      "requires_bsl": true,
      "required_patterns": [
        "ОбщегоНазначения\\.СообщитьПользователю\\s*\\(",
        "Контрагент",
        "Отказ"
      ],
      "forbidden_patterns": [
        "Новый\\s+СообщениеПользователю"
      ]
    },
